{
  "manifest_version": 3,
  "name": "Auto Skip",
  "version": "2.1.0",
  "author": "Floppa <floppa@meows.bot>",
  "description": "Automatically clicks Skip Intro / Skip Recap / Skip Credits on Crunchyroll, Netflix, Disney+, Prime Video, HBO Max, Hulu and more. On for every service out of the box; turn off the ones you don't want.",
  "permissions": ["storage", "scripting"],
  "host_permissions": [
    "https://*.crunchyroll.com/*",
    "https://*.netflix.com/*",
    "https://*.disneyplus.com/*",
    "https://*.primevideo.com/*",
    "https://www.amazon.com/*",
    "https://www.amazon.co.uk/*",
    "https://www.amazon.de/*",
    "https://www.amazon.co.jp/*",
    "https://*.max.com/*",
    "https://*.hbomax.com/*",
    "https://*.hulu.com/*",
    "https://*.paramountplus.com/*",
    "https://*.peacocktv.com/*",
    "https://tv.apple.com/*",
    "https://*.youtube.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Auto Skip",
    "default_popup": "settings.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "settings.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
